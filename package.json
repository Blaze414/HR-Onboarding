{
  "name": "snoopy-workplace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "desktop": "npm run dev -w @snoopy/desktop",
    "mobile": "npm --prefix apps/mobile run start",
    "typecheck": "npm run typecheck -w @snoopy/shared && npm run typecheck -w @snoopy/desktop && npm --prefix apps/mobile run typecheck",
    "dev": "node scripts/dev-all.mjs",
    "dev:desktop": "npm run dev -w @snoopy/desktop",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "check": "node scripts/checks/run-all.mjs",
    "email:send": "node scripts/send-email.mjs",
    "push:send": "node scripts/send-push.mjs",
    "install:mobile": "npm install --prefix apps/mobile",
    "postinstall": "npm run install:mobile --silent"
  }
}
