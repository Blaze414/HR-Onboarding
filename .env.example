# Values printed by `npx supabase start`.

# --- Desktop (Next.js) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>
# Server-side only. Used to create and invite users; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# --- Mobile (Expo) -----------------------------------------------------------
# A simulator can reach 127.0.0.1; a physical device needs your machine's LAN address.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>

# --- Cross-client hints (optional) -------------------------------------------
# Each client shows a dismissible pointer to the other when the screen size
# suits it better. Unset, both fall back to the sibling dev server on the same
# host, so local development needs no configuration.
NEXT_PUBLIC_MOBILE_APP_URL=
EXPO_PUBLIC_DESKTOP_APP_URL=

# --- Reminders by email (optional) -------------------------------------------
# The database queues a message whenever it raises a notification;
# `npm run email:send` drains the queue by POSTing {to, subject, text} here.
# Unset, the sender prints what it would have sent and queues stay put, so
# local work never needs mail configured.
EMAIL_WEBHOOK_URL=
EMAIL_FROM=no-reply@example.test
# Prefixed to the link in each reminder, so a mail can be acted on.
NEXT_PUBLIC_APP_URL=

# Reminders on a phone that is shut. The queue is written whatever these say;
# these only decide whether anything drains it.
# Unset, `npm run push:send` prints what it would have delivered.
PUSH_ENABLED=
# Only needed if the Expo project has push security enabled.
EXPO_ACCESS_TOKEN=
